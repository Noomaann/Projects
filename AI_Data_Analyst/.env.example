# ============================================
#   AI Data Analyst Agent - Environment Config
#   Copy this file to backend/.env and fill in
#   your actual values. Never commit .env!
# ============================================

# Google Gemini API Key
# Get yours free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# PostgreSQL Database Connection String
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ai_analyst_db"
